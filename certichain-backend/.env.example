DATABASE_URL=jdbc:postgresql://localhost:5432/certichain
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

REDIS_URL=redis://localhost:6379

# Resend (resend.com) for notification emails - sign up free, create an API
# key under Dashboard > API Keys. HTTP-based, so it isn't affected by ISPs/
# routers that block raw SMTP ports (25/465/587), unlike Gmail SMTP.
RESEND_API_KEY=re_your_api_key
