DATABASE_URL=jdbc:postgresql://localhost:5432/certichain
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

REDIS_URL=redis://localhost:6379

# Gmail SMTP (App Password)
# 1) Enable 2-Step Verification on the Gmail account
# 2) Google Account → Security → App passwords → Mail → copy 16-char code (spaces optional)
GMAIL_ADDRESS=certichainofficial.noreply@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
MAIL_FROM=CertiChain <certichainofficial.noreply@gmail.com>

# Supabase Storage for institution profile images
# Create a public bucket (e.g. institution-profiles) in Supabase Dashboard > Storage
# SUPABASE_URL is your project URL (https://<project>.supabase.co)
# Service role key is under Project Settings > API > service_role (secret, never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET=institution-profiles

# PII envelope encryption (AES-256-GCM). KEK must decode to exactly 32 UTF-8 bytes,
# HMAC key at least 32 bytes. Generate fresh values per environment, never reuse dev's.
# ENCRYPTION_KEK=change-me-to-32-bytes-exactly-0000
# ENCRYPTION_HMAC_KEY=change-me-to-at-least-32-bytes-000000000
# One-time PII backfill (existing rows): BACKFILL_PII_ENCRYPTION=true for one boot, then off.
# BACKFILL_PII_ENCRYPTION=false

# Public base stamped into emailed links/logo. Dev default follows FRONTEND_URL;
# prod must set the real public origin (LAN IPs don't work from mail clients).
# EMAIL_PUBLIC_BASE_URL=https://app.example.com
